{
  "name": "aegis-core",
  "version": "1.0.0",
  "description": "Autonomous Engine for Program Vulnerability Repair and Formal Invariant Verification in CI/CD Pipelines",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "tsc && node dist/server/server.js",
    "server": "node dist/server/server.js",
    "db:seed": "node dist/db/seed.js",
    "db:inspect": "node dist/db/inspect.js",
    "analyze": "tsc && node dist/index.js",
    "test": "tsc && node dist/tests/run-all-tests.js"
  },
  "keywords": [
    "security",
    "ast",
    "formal-verification",
    "automated-program-repair",
    "devsecops",
    "z3-smt"
  ],
  "author": "Areeb Iqbal",
  "license": "MIT",
  "dependencies": {
    "@babel/generator": "^7.26.0",
    "@babel/parser": "^7.26.0",
    "@babel/traverse": "^7.26.0",
    "@babel/types": "^7.26.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "better-sqlite3": "^13.2.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "z3-solver": "^5.4.1"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.6.8",
    "@types/babel__traverse": "^7.20.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
